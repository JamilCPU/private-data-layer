# Copy to .env (gitignored). Generate the value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HOMESTUDIO_MCP_SECRET=replace-with-python-secrets-token_urlsafe-32

# Shared secrets the gateway sends to bank-mcp and email-mcp (same generator).
BANK_MCP_SECRET=replace-with-python-secrets-token_urlsafe-32
EMAIL_MCP_SECRET=replace-with-python-secrets-token_urlsafe-32

# Dev-only Postgres password (single dev role `lab_dev`; the cluster uses separate roles).
POSTGRES_PASSWORD=replace-with-python-secrets-token_urlsafe-32

# Only for `--profile jobs run email-sync`: the IMAP account to read. The app password goes in
# ./imap.password (gitignored), never here.
EMAIL_IMAP_HOST=imap.example.invalid
EMAIL_IMAP_USER=you@example.invalid

# Assistant: where Ollama listens (default: the Docker host) and which model to use.
OLLAMA_URL=http://host.docker.internal:11434
ASSISTANT_MODEL=qwen3.5:27b
